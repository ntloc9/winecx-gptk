diff --git a/dlls/winexinput.sys/main.c b/dlls/winexinput.sys/main.c
index e79bb314..288cd053 100644
--- a/dlls/winexinput.sys/main.c
+++ b/dlls/winexinput.sys/main.c
@@ -195,9 +195,9 @@ static void translate_report_to_xinput_state(struct func_device *fdo)
 {
     ULONG lx = 0, ly = 0, rx = 0, ry = 0, lt = 0, rt = 0, hat = 0;
     PHIDP_PREPARSED_DATA preparsed;
-    USAGE usages[10];
+    USAGE usages[15];
     NTSTATUS status;
-    ULONG i, count;
+    ULONG i, count, dpad = 0;
 
     preparsed = fdo->device_desc.CollectionDesc->PreparsedData;
 
@@ -227,13 +227,30 @@ static void translate_report_to_xinput_state(struct func_device *fdo)
                                 &rt, preparsed, fdo->report_buf, fdo->report_len);
     if (status != HIDP_STATUS_SUCCESS) WARN("HidP_GetUsageValue rz returned %#lx\n", status);
 
-    if (hat < 1 || hat > 8) fdo->xinput_state.buttons = 0;
-    else fdo->xinput_state.buttons = hat << 10;
+    fdo->xinput_state.buttons = 0;
     for (i = 0; i < count; i++)
     {
-        if (usages[i] < 1 || usages[i] > 10) continue;
-        fdo->xinput_state.buttons |= (1 << (usages[i] - 1));
+        if (usages[i] >= 1 && usages[i] <= 10)
+            fdo->xinput_state.buttons |= (1 << (usages[i] - 1));
+        else if (usages[i] >= 12 && usages[i] <= 15)
+            dpad |= 1 << (usages[i] - 12);
     }
+    if (hat < 1 || hat > 8)
+    {
+        /* Some Xbox-compatible HID descriptors expose the D-pad as buttons. */
+        switch (dpad)
+        {
+        case 0x1: hat = 1; break; /* up */
+        case 0x9: hat = 2; break; /* up + right */
+        case 0x8: hat = 3; break; /* right */
+        case 0xa: hat = 4; break; /* down + right */
+        case 0x2: hat = 5; break; /* down */
+        case 0x6: hat = 6; break; /* down + left */
+        case 0x4: hat = 7; break; /* left */
+        case 0x5: hat = 8; break; /* up + left */
+        }
+    }
+    if (hat >= 1 && hat <= 8) fdo->xinput_state.buttons |= hat << 10;
     fdo->xinput_state.lx_axis = scale_value(lx, &fdo->lx_caps, 0, 65535);
     fdo->xinput_state.ly_axis = 65535 - scale_value(ly, &fdo->ly_caps, 0, 65535);
     fdo->xinput_state.rx_axis = scale_value(rx, &fdo->rx_caps, 0, 65535);
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
