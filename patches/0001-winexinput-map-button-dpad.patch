+        case 14: state.Gamepad.wButtons |= XINPUT_GAMEPAD_DPAD_LEFT; break;
+        case 15: state.Gamepad.wButtons |= XINPUT_GAMEPAD_DPAD_RIGHT; break;
         }
     }
 
